---
import { Font } from "astro:assets";
import "../styles/global.css";
import { twMerge } from "tailwind-merge";

interface Props {
  title?: string;
  class?: string;
}
---

<!doctype html>
<html lang="en" class="bg-(image:--background-image-paper)">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{Astro.props.title}</title>

    <Font cssVariable="--font-g-display" preload />
    <Font cssVariable="--font-g-body" preload />
  </head>
  <body
    class={twMerge(
      "mx-auto max-w-7xl px-6 py-8 md:px-8 lg:p-20",
      Astro.props.class,
    )}
  >
    <slot />
  </body>
</html>
