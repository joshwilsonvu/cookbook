---
import { getEntry } from "astro:content";
import { getTitle } from "../utils";
import { Icon } from "astro-icon/components";

interface Props {
  id: string;
}

const recipe = await getEntry("recipes", Astro.props.id)!;
const hue = Math.floor(Math.random() * 360);
const color = `oklch(98% 8% ${hue}deg)`;
---

<a href={`/recipes/${recipe.id}`} class="contents">
  <article
    class="rounded border border-tx-3 px-4 py-3 hover:bg-(--color)"
    style={{ "--color": color }}
  >
    <p class="text-lg">{recipe.data.title || getTitle(recipe.id)}</p>
    <p class="flex items-center gap-[1ch] italic text-sm">
      <Icon name="lucide:heart" />
      From {recipe.data.author}&apos;s kitchen
    </p>
  </article>
</a>
