---
import { exec } from "node:child_process";
import { promisify } from "node:util";
import { twMerge } from "tailwind-merge";
import { getEntry, render } from "astro:content";
import Author from "./Author.astro";
import { format, getTitle } from "../utils";

interface Props {
  id: string;
  class?: string;
}

const { id } = Astro.props;
const recipe = await getEntry("recipes", id);
if (!recipe) {
  throw new Error("no recipe");
}
const lastModified = (
  await promisify(exec)(`git log -1 --pretty="format:%cI" "${recipe.filePath}"`)
).stdout;

const { author, ingredients, notes } = recipe.data;
const title = getTitle(recipe);
const { Content } = await render(recipe);

const ldJson = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  author,
  datePublished: lastModified,
  name: title,
};
---

<article class={twMerge("break-inside-avoid", Astro.props.class)}>
  <div class="mb-8">
    <h2 class="h1 capitalize">{title}</h2>
    <Author author={recipe.data.author} />
    <div class="flex flex-col items-stretch gap-8 md:flex-row print:flex-row">
      <div class="max-w-max grow-1 basis-0">
        <h3 class="h2">ingredients</h3>
        {
          Array.isArray(ingredients) ? (
            <ul>
              {ingredients.map(format).map((ingredient) => (
                <li>{ingredient}</li>
              ))}
            </ul>
          ) : (
            Object.entries(ingredients).map(([section, sectionIngredients]) => (
              <div>
                <p class="mt-4 font-bold capitalize">{section}</p>
                <ul>
                  {sectionIngredients.map(format).map((ingredient) => (
                    <li>{ingredient}</li>
                  ))}
                </ul>
              </div>
            ))
          )
        }
        {notes && <p class="whitespace-pre-wrap">{notes}</p>}
      </div>
      <div class="hidden basis-0.25 bg-tx md:block print:block"></div>
      <div class="grow-2 basis-0">
        <h3 class="h2">directions</h3>
        <Content />
      </div>
    </div>
  </div>
  <script
    type="application/json+ld"
    is:inline
    set:html={JSON.stringify(ldJson, null, 2)}
  />
</article>
