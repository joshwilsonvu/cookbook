---
import { getEntry } from "astro:content";
import { getTitle } from "../utils";
import Author from "./Author.astro";

interface Props {
  id: string;
}

const recipe = await getEntry("recipes", Astro.props.id)!;
---

<a
  href={`/recipes/${recipe.id}`}
  class="group flex flex-col items-baseline sm:flex-row sm:gap-2"
>
  <p
    class="flex-shrink text-lg underline-offset-2 group-hover:underline group-focus:underline"
  >
    {getTitle(recipe)}
  </p>
  <span
    class="h-px flex-1 translate-y-[2px] border-t border-dotted group-hover:border-solid"
  ></span>
  <Author author={recipe.data.author} />
</a>
