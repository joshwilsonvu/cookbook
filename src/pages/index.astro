---
import { getCollection } from "astro:content";
import * as _ from "lodash-es";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import { getTitle } from "../utils";
import Category from "../components/Category.astro";
import RecipeItem from "../components/RecipeItem.astro";

const recipes = await getCollection("recipes");

function recipesByCourse(course: string) {
  return _.sortBy(
    recipes.filter((r) => r.data.course === course),
    (r) => getTitle(r),
  );
}
---

<Layout title="Our kitchen table" class="max-w-5xl">
  <div class="flex flex-col gap-20">
    <Header />
    <Category name="Entrées">
      {recipesByCourse("entrée").map((r) => <RecipeItem id={r.id} />)}
    </Category>
    <Category name="Appetizers & sides">
      {recipesByCourse("side").map((r) => <RecipeItem id={r.id} />)}
    </Category>
    <Category name="Salads">
      {recipesByCourse("salad").map((r) => <RecipeItem id={r.id} />)}
    </Category>
    <Category name="Soups">
      {recipesByCourse("soup").map((r) => <RecipeItem id={r.id} />)}
    </Category>
    <Category name="Breakfast">
      {recipesByCourse("breakfast").map((r) => <RecipeItem id={r.id} />)}
    </Category>
    <Category name="Drinks">
      {recipesByCourse("beverage").map((r) => <RecipeItem id={r.id} />)}
    </Category>
  </div>
</Layout>
