{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cookbook",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-22", // Update to the day you deploy
  "vars": {
    "GH_OWNER": "joshwilsonvu",
    "GH_REPO": "cookbook",
    "GH_DEFAULT_BRANCH": "main",
    "DESTINATION_MARKDOWN_FOLDER": "src/data/recipes",
  },
  "preview_urls": true,
  "ai": {
    "binding": "AI",
    "remote": true,
  },
  "workflows": [
    {
      "binding": "SUBMISSION_WORKFLOW",
      "name": "SubmissionWorkflow",
      "class_name": "SubmissionWorkflow",
    },
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
